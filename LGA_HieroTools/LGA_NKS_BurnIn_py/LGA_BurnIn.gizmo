 BlinkScript {
  onCreate "__import__('LGA_NKS_BurnIn_Blink').setup(nuke.thisNode())"
  kernelSource "// LGA_RoundedPanels v0.03 | Lega\n// Kernel de produccion de LGA_BurnIn: fondos redondeados de los seis\n// campos en una pasada. SDF de rounded box + antialiasing de 1px.\n// v0.03: sin funcion miembro, logica inline por campo (la funcion no\n//        compilaba en el contexto del timeline).\n// v0.02: una declaracion por linea.\n\nkernel LGARoundedPanels : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> src;\n  Image<eWrite, eAccessPoint> dst;\n\n  param:\n    float clip_x;\n    float clip_y;\n    float clip_w;\n    float clip_h;\n    float clip_on;\n    float res_x;\n    float res_y;\n    float res_w;\n    float res_h;\n    float res_on;\n    float frame_x;\n    float frame_y;\n    float frame_w;\n    float frame_h;\n    float frame_on;\n    float tc_x;\n    float tc_y;\n    float tc_w;\n    float tc_h;\n    float tc_on;\n    float cspace_x;\n    float cspace_y;\n    float cspace_w;\n    float cspace_h;\n    float cspace_on;\n    float fps_x;\n    float fps_y;\n    float fps_w;\n    float fps_h;\n    float fps_on;\n    float corner_radius;\n    float color_r;\n    float color_g;\n    float color_b;\n    float bg_opacity;\n\n  void define() \{\n    defineParam(clip_x, \"clip_x\", 0.0f);\n    defineParam(clip_y, \"clip_y\", 0.0f);\n    defineParam(clip_w, \"clip_w\", 0.0f);\n    defineParam(clip_h, \"clip_h\", 0.0f);\n    defineParam(clip_on, \"clip_on\", 0.0f);\n    defineParam(res_x, \"res_x\", 0.0f);\n    defineParam(res_y, \"res_y\", 0.0f);\n    defineParam(res_w, \"res_w\", 0.0f);\n    defineParam(res_h, \"res_h\", 0.0f);\n    defineParam(res_on, \"res_on\", 0.0f);\n    defineParam(frame_x, \"frame_x\", 0.0f);\n    defineParam(frame_y, \"frame_y\", 0.0f);\n    defineParam(frame_w, \"frame_w\", 0.0f);\n    defineParam(frame_h, \"frame_h\", 0.0f);\n    defineParam(frame_on, \"frame_on\", 0.0f);\n    defineParam(tc_x, \"tc_x\", 0.0f);\n    defineParam(tc_y, \"tc_y\", 0.0f);\n    defineParam(tc_w, \"tc_w\", 0.0f);\n    defineParam(tc_h, \"tc_h\", 0.0f);\n    defineParam(tc_on, \"tc_on\", 0.0f);\n    defineParam(cspace_x, \"cspace_x\", 0.0f);\n    defineParam(cspace_y, \"cspace_y\", 0.0f);\n    defineParam(cspace_w, \"cspace_w\", 0.0f);\n    defineParam(cspace_h, \"cspace_h\", 0.0f);\n    defineParam(cspace_on, \"cspace_on\", 0.0f);\n    defineParam(fps_x, \"fps_x\", 0.0f);\n    defineParam(fps_y, \"fps_y\", 0.0f);\n    defineParam(fps_w, \"fps_w\", 0.0f);\n    defineParam(fps_h, \"fps_h\", 0.0f);\n    defineParam(fps_on, \"fps_on\", 0.0f);\n    defineParam(corner_radius, \"corner_radius\", 30.0f);\n    defineParam(color_r, \"color_r\", 0.0f);\n    defineParam(color_g, \"color_g\", 0.0f);\n    defineParam(color_b, \"color_b\", 0.0f);\n    defineParam(bg_opacity, \"bg_opacity\", 0.8f);\n  \}\n\n  void process(int2 pos) \{\n    SampleType(src) input = src();\n    float ppx = float(pos.x);\n    float ppy = float(pos.y);\n    float a = 0.0f;\n\n    // panel clip\n    if (clip_on > 0.5f && clip_w > 0.0f && clip_h > 0.0f) \{\n      float r = min(corner_radius, min(clip_w, clip_h) * 0.5f);\n      float cx = clip_x + clip_w * 0.5f;\n      float cy = clip_y + clip_h * 0.5f;\n      float dx = fabs(ppx - cx) - (clip_w * 0.5f - r);\n      float dy = fabs(ppy - cy) - (clip_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    // panel res\n    if (res_on > 0.5f && res_w > 0.0f && res_h > 0.0f) \{\n      float r = min(corner_radius, min(res_w, res_h) * 0.5f);\n      float cx = res_x + res_w * 0.5f;\n      float cy = res_y + res_h * 0.5f;\n      float dx = fabs(ppx - cx) - (res_w * 0.5f - r);\n      float dy = fabs(ppy - cy) - (res_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    // panel frame\n    if (frame_on > 0.5f && frame_w > 0.0f && frame_h > 0.0f) \{\n      float r = min(corner_radius, min(frame_w, frame_h) * 0.5f);\n      float cx = frame_x + frame_w * 0.5f;\n      float cy = frame_y + frame_h * 0.5f;\n      float dx = fabs(ppx - cx) - (frame_w * 0.5f - r);\n      float dy = fabs(ppy - cy) - (frame_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    // panel tc\n    if (tc_on > 0.5f && tc_w > 0.0f && tc_h > 0.0f) \{\n      float r = min(corner_radius, min(tc_w, tc_h) * 0.5f);\n      float cx = tc_x + tc_w * 0.5f;\n      float cy = tc_y + tc_h * 0.5f;\n      float dx = fabs(ppx - cx) - (tc_w * 0.5f - r);\n      float dy = fabs(ppy - cy) - (tc_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    // panel cspace\n    if (cspace_on > 0.5f && cspace_w > 0.0f && cspace_h > 0.0f) \{\n      float r = min(corner_radius, min(cspace_w, cspace_h) * 0.5f);\n      float cx = cspace_x + cspace_w * 0.5f;\n      float cy = cspace_y + cspace_h * 0.5f;\n      float dx = fabs(ppx - cx) - (cspace_w * 0.5f - r);\n      float dy = fabs(ppy - cy) - (cspace_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    // panel fps\n    if (fps_on > 0.5f && fps_w > 0.0f && fps_h > 0.0f) \{\n      float r = min(corner_radius, min(fps_w, fps_h) * 0.5f);\n      float cx = fps_x + fps_w * 0.5f;\n      float cy = fps_y + fps_h * 0.5f;\n      float dx = fabs(ppx - cx) - (fps_w * 0.5f - r);\n      float dy = fabs(ppy - cy) - (fps_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    a = a * bg_opacity;\n    float4 panel = float4(color_r, color_g, color_b, 1.0f);\n    dst() = input * (1.0f - a) + panel * a;\n  \}\n\};\n"
  rebuild ""
  rebuild_finalise ""
  name Blink_Panels
  xpos -217
  ypos 100
 }
