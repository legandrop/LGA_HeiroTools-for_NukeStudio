 }
 BlinkScript {
  onCreate "__import__('LGA_NKS_BurnIn_Blink').setup(nuke.thisNode())"
  kernelSource "// LGA_RoundedPanels v0.04 | Lega\n// Fondos redondeados de los campos del burn-in, en una pasada.\n// SDF de rounded box + antialiasing 1px, con rotacion por campo.\n// v0.04: rotacion por campo (ax,ay = ancla; rot en radianes).\n// v0.03: sin funcion miembro, logica inline por campo.\n\nkernel LGARoundedPanels : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> src;\n  Image<eWrite, eAccessPoint> dst;\n\n  param:\n    float clip_x;\n    float clip_y;\n    float clip_w;\n    float clip_h;\n    float clip_on;\n    float clip_ax;\n    float clip_ay;\n    float clip_rot;\n    float cspace_x;\n    float cspace_y;\n    float cspace_w;\n    float cspace_h;\n    float cspace_on;\n    float cspace_ax;\n    float cspace_ay;\n    float cspace_rot;\n    float res_x;\n    float res_y;\n    float res_w;\n    float res_h;\n    float res_on;\n    float res_ax;\n    float res_ay;\n    float res_rot;\n    float frame_x;\n    float frame_y;\n    float frame_w;\n    float frame_h;\n    float frame_on;\n    float frame_ax;\n    float frame_ay;\n    float frame_rot;\n    float tc_x;\n    float tc_y;\n    float tc_w;\n    float tc_h;\n    float tc_on;\n    float tc_ax;\n    float tc_ay;\n    float tc_rot;\n    float fps_x;\n    float fps_y;\n    float fps_w;\n    float fps_h;\n    float fps_on;\n    float fps_ax;\n    float fps_ay;\n    float fps_rot;\n    float custom1_x;\n    float custom1_y;\n    float custom1_w;\n    float custom1_h;\n    float custom1_on;\n    float custom1_ax;\n    float custom1_ay;\n    float custom1_rot;\n    float custom2_x;\n    float custom2_y;\n    float custom2_w;\n    float custom2_h;\n    float custom2_on;\n    float custom2_ax;\n    float custom2_ay;\n    float custom2_rot;\n    float corner_radius;\n    float color_r;\n    float color_g;\n    float color_b;\n    float bg_opacity;\n\n  void define() \{\n    defineParam(clip_x, \"clip_x\", 0.0f);\n    defineParam(clip_y, \"clip_y\", 0.0f);\n    defineParam(clip_w, \"clip_w\", 0.0f);\n    defineParam(clip_h, \"clip_h\", 0.0f);\n    defineParam(clip_on, \"clip_on\", 0.0f);\n    defineParam(clip_ax, \"clip_ax\", 0.0f);\n    defineParam(clip_ay, \"clip_ay\", 0.0f);\n    defineParam(clip_rot, \"clip_rot\", 0.0f);\n    defineParam(cspace_x, \"cspace_x\", 0.0f);\n    defineParam(cspace_y, \"cspace_y\", 0.0f);\n    defineParam(cspace_w, \"cspace_w\", 0.0f);\n    defineParam(cspace_h, \"cspace_h\", 0.0f);\n    defineParam(cspace_on, \"cspace_on\", 0.0f);\n    defineParam(cspace_ax, \"cspace_ax\", 0.0f);\n    defineParam(cspace_ay, \"cspace_ay\", 0.0f);\n    defineParam(cspace_rot, \"cspace_rot\", 0.0f);\n    defineParam(res_x, \"res_x\", 0.0f);\n    defineParam(res_y, \"res_y\", 0.0f);\n    defineParam(res_w, \"res_w\", 0.0f);\n    defineParam(res_h, \"res_h\", 0.0f);\n    defineParam(res_on, \"res_on\", 0.0f);\n    defineParam(res_ax, \"res_ax\", 0.0f);\n    defineParam(res_ay, \"res_ay\", 0.0f);\n    defineParam(res_rot, \"res_rot\", 0.0f);\n    defineParam(frame_x, \"frame_x\", 0.0f);\n    defineParam(frame_y, \"frame_y\", 0.0f);\n    defineParam(frame_w, \"frame_w\", 0.0f);\n    defineParam(frame_h, \"frame_h\", 0.0f);\n    defineParam(frame_on, \"frame_on\", 0.0f);\n    defineParam(frame_ax, \"frame_ax\", 0.0f);\n    defineParam(frame_ay, \"frame_ay\", 0.0f);\n    defineParam(frame_rot, \"frame_rot\", 0.0f);\n    defineParam(tc_x, \"tc_x\", 0.0f);\n    defineParam(tc_y, \"tc_y\", 0.0f);\n    defineParam(tc_w, \"tc_w\", 0.0f);\n    defineParam(tc_h, \"tc_h\", 0.0f);\n    defineParam(tc_on, \"tc_on\", 0.0f);\n    defineParam(tc_ax, \"tc_ax\", 0.0f);\n    defineParam(tc_ay, \"tc_ay\", 0.0f);\n    defineParam(tc_rot, \"tc_rot\", 0.0f);\n    defineParam(fps_x, \"fps_x\", 0.0f);\n    defineParam(fps_y, \"fps_y\", 0.0f);\n    defineParam(fps_w, \"fps_w\", 0.0f);\n    defineParam(fps_h, \"fps_h\", 0.0f);\n    defineParam(fps_on, \"fps_on\", 0.0f);\n    defineParam(fps_ax, \"fps_ax\", 0.0f);\n    defineParam(fps_ay, \"fps_ay\", 0.0f);\n    defineParam(fps_rot, \"fps_rot\", 0.0f);\n    defineParam(custom1_x, \"custom1_x\", 0.0f);\n    defineParam(custom1_y, \"custom1_y\", 0.0f);\n    defineParam(custom1_w, \"custom1_w\", 0.0f);\n    defineParam(custom1_h, \"custom1_h\", 0.0f);\n    defineParam(custom1_on, \"custom1_on\", 0.0f);\n    defineParam(custom1_ax, \"custom1_ax\", 0.0f);\n    defineParam(custom1_ay, \"custom1_ay\", 0.0f);\n    defineParam(custom1_rot, \"custom1_rot\", 0.0f);\n    defineParam(custom2_x, \"custom2_x\", 0.0f);\n    defineParam(custom2_y, \"custom2_y\", 0.0f);\n    defineParam(custom2_w, \"custom2_w\", 0.0f);\n    defineParam(custom2_h, \"custom2_h\", 0.0f);\n    defineParam(custom2_on, \"custom2_on\", 0.0f);\n    defineParam(custom2_ax, \"custom2_ax\", 0.0f);\n    defineParam(custom2_ay, \"custom2_ay\", 0.0f);\n    defineParam(custom2_rot, \"custom2_rot\", 0.0f);\n    defineParam(corner_radius, \"corner_radius\", 30.0f);\n    defineParam(color_r, \"color_r\", 0.0f);\n    defineParam(color_g, \"color_g\", 0.0f);\n    defineParam(color_b, \"color_b\", 0.0f);\n    defineParam(bg_opacity, \"bg_opacity\", 0.8f);\n  \}\n\n  void process(int2 pos) \{\n    SampleType(src) input = src();\n    float ppx = float(pos.x);\n    float ppy = float(pos.y);\n    float a = 0.0f;\n\n    // panel clip\n    if (clip_on > 0.5f && clip_w > 0.0f && clip_h > 0.0f) \{\n      float cx = clip_x + clip_w * 0.5f;\n      float cy = clip_y + clip_h * 0.5f;\n      float ca = cos(clip_rot);\n      float sa = sin(clip_rot);\n      float rx = ppx - clip_ax;\n      float ry = ppy - clip_ay;\n      float lx = ca * rx + sa * ry + clip_ax - cx;\n      float ly = -sa * rx + ca * ry + clip_ay - cy;\n      float r = min(corner_radius, min(clip_w, clip_h) * 0.5f);\n      float dx = fabs(lx) - (clip_w * 0.5f - r);\n      float dy = fabs(ly) - (clip_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    // panel cspace\n    if (cspace_on > 0.5f && cspace_w > 0.0f && cspace_h > 0.0f) \{\n      float cx = cspace_x + cspace_w * 0.5f;\n      float cy = cspace_y + cspace_h * 0.5f;\n      float ca = cos(cspace_rot);\n      float sa = sin(cspace_rot);\n      float rx = ppx - cspace_ax;\n      float ry = ppy - cspace_ay;\n      float lx = ca * rx + sa * ry + cspace_ax - cx;\n      float ly = -sa * rx + ca * ry + cspace_ay - cy;\n      float r = min(corner_radius, min(cspace_w, cspace_h) * 0.5f);\n      float dx = fabs(lx) - (cspace_w * 0.5f - r);\n      float dy = fabs(ly) - (cspace_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    // panel res\n    if (res_on > 0.5f && res_w > 0.0f && res_h > 0.0f) \{\n      float cx = res_x + res_w * 0.5f;\n      float cy = res_y + res_h * 0.5f;\n      float ca = cos(res_rot);\n      float sa = sin(res_rot);\n      float rx = ppx - res_ax;\n      float ry = ppy - res_ay;\n      float lx = ca * rx + sa * ry + res_ax - cx;\n      float ly = -sa * rx + ca * ry + res_ay - cy;\n      float r = min(corner_radius, min(res_w, res_h) * 0.5f);\n      float dx = fabs(lx) - (res_w * 0.5f - r);\n      float dy = fabs(ly) - (res_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    // panel frame\n    if (frame_on > 0.5f && frame_w > 0.0f && frame_h > 0.0f) \{\n      float cx = frame_x + frame_w * 0.5f;\n      float cy = frame_y + frame_h * 0.5f;\n      float ca = cos(frame_rot);\n      float sa = sin(frame_rot);\n      float rx = ppx - frame_ax;\n      float ry = ppy - frame_ay;\n      float lx = ca * rx + sa * ry + frame_ax - cx;\n      float ly = -sa * rx + ca * ry + frame_ay - cy;\n      float r = min(corner_radius, min(frame_w, frame_h) * 0.5f);\n      float dx = fabs(lx) - (frame_w * 0.5f - r);\n      float dy = fabs(ly) - (frame_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    // panel tc\n    if (tc_on > 0.5f && tc_w > 0.0f && tc_h > 0.0f) \{\n      float cx = tc_x + tc_w * 0.5f;\n      float cy = tc_y + tc_h * 0.5f;\n      float ca = cos(tc_rot);\n      float sa = sin(tc_rot);\n      float rx = ppx - tc_ax;\n      float ry = ppy - tc_ay;\n      float lx = ca * rx + sa * ry + tc_ax - cx;\n      float ly = -sa * rx + ca * ry + tc_ay - cy;\n      float r = min(corner_radius, min(tc_w, tc_h) * 0.5f);\n      float dx = fabs(lx) - (tc_w * 0.5f - r);\n      float dy = fabs(ly) - (tc_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    // panel fps\n    if (fps_on > 0.5f && fps_w > 0.0f && fps_h > 0.0f) \{\n      float cx = fps_x + fps_w * 0.5f;\n      float cy = fps_y + fps_h * 0.5f;\n      float ca = cos(fps_rot);\n      float sa = sin(fps_rot);\n      float rx = ppx - fps_ax;\n      float ry = ppy - fps_ay;\n      float lx = ca * rx + sa * ry + fps_ax - cx;\n      float ly = -sa * rx + ca * ry + fps_ay - cy;\n      float r = min(corner_radius, min(fps_w, fps_h) * 0.5f);\n      float dx = fabs(lx) - (fps_w * 0.5f - r);\n      float dy = fabs(ly) - (fps_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    // panel custom1\n    if (custom1_on > 0.5f && custom1_w > 0.0f && custom1_h > 0.0f) \{\n      float cx = custom1_x + custom1_w * 0.5f;\n      float cy = custom1_y + custom1_h * 0.5f;\n      float ca = cos(custom1_rot);\n      float sa = sin(custom1_rot);\n      float rx = ppx - custom1_ax;\n      float ry = ppy - custom1_ay;\n      float lx = ca * rx + sa * ry + custom1_ax - cx;\n      float ly = -sa * rx + ca * ry + custom1_ay - cy;\n      float r = min(corner_radius, min(custom1_w, custom1_h) * 0.5f);\n      float dx = fabs(lx) - (custom1_w * 0.5f - r);\n      float dy = fabs(ly) - (custom1_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    // panel custom2\n    if (custom2_on > 0.5f && custom2_w > 0.0f && custom2_h > 0.0f) \{\n      float cx = custom2_x + custom2_w * 0.5f;\n      float cy = custom2_y + custom2_h * 0.5f;\n      float ca = cos(custom2_rot);\n      float sa = sin(custom2_rot);\n      float rx = ppx - custom2_ax;\n      float ry = ppy - custom2_ay;\n      float lx = ca * rx + sa * ry + custom2_ax - cx;\n      float ly = -sa * rx + ca * ry + custom2_ay - cy;\n      float r = min(corner_radius, min(custom2_w, custom2_h) * 0.5f);\n      float dx = fabs(lx) - (custom2_w * 0.5f - r);\n      float dy = fabs(ly) - (custom2_h * 0.5f - r);\n      float qx = max(dx, 0.0f);\n      float qy = max(dy, 0.0f);\n      float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - r;\n      a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n    \}\n\n    a = a * bg_opacity;\n    float4 panel = float4(color_r, color_g, color_b, 1.0f);\n    dst() = input * (1.0f - a) + panel * a;\n  \}\n\};\n"
  rebuild ""
  rebuild_finalise ""
  name Blink_Panels
  xpos -217
  ypos 100
 }
 Text2 {
  font_size_toolbar 100
  font_width_toolbar 100
  font_height_toolbar 100
  opacity {{parent.bi_opacity}}
  message "\[python __import__('LGA_NKS_BurnIn_Logic').bi_text('clip', nuke.thisParent(), \[frame\])]"
  old_message {{48 49 58 48 48 58 48 48 58 48 48}
    }
  old_expression_markers {{0 10}
    }
  box {{"parent.bi_clip_x*width+parent.bi_text_pad"} {"parent.bi_clip_y*height"} {"width"} {"parent.bi_clip_y*height+100*parent.bi_scale*parent.bi_clip_size/100*1.3+parent.bi_text_pad"}}
  yjustify center
  cliptype none
  transforms {{0 2}
    }
  font "\[value parent.bi_font]"
  cursor_position 74
  global_font_scale {{parent.bi_scale*parent.bi_clip_size/100}}
  scale {1 1}
  cursor_initialised true
  autofit_bbox false
  initial_cursor_position {{0 1556}
    }
  group_animations {{0} imported: 0 selected: items: "root transform/"}
